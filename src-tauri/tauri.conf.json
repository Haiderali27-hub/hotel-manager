{
    "$schema":  "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName":  "INERTIA",
    "version":  "1.0.0",
    "identifier":  "com.inertia.app",
    "build":  {
                  "frontendDist":  "../dist",
                  "devUrl":  "http://localhost:5173",
                  "beforeDevCommand":  "npm run dev",
                  "beforeBuildCommand":  "npm run build"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "INERTIA",
                                    "width":  1200,
                                    "height":  800,
                                    "resizable":  true,
                                    "fullscreen":  false,
                                    "center":  true,
                                    "decorations":  true
                                }
                            ],
                "security":  {
                                 "csp":  null
                             },
                "trayIcon":  {
                                 "iconPath":  "icons/icon.ico"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "msi",
                                   "nsis"
                               ],
                   "createUpdaterArtifacts":  "v1Compatible",
                   "icon":  [
                                "icons/icon.png",
                                "icons/icon.ico"
                            ],
                   "resources":  [
                                     "../src/assets/Logo/logo.png"
                                 ]
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBNkQ4MjI0MzQwMTAzRkEKUldUNkF3RTBKSUp0eXZ4V0V3T3hmRllncFM0dXJONmNZU1RRbWY5R2NickFiQ2llcXB6YUJvSGwK",
                                    "endpoints":  [
                                                      "https://github.com/Haiderali27-hub/inertia-pos-releases/releases/latest/download/latest.json"
                                                  ],
                                    "dialog":  true,
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                }
                }
}